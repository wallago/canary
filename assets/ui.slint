import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

export component EnvironmentDisplay inherits Window {
    width: 360px;
    height: 360px;

    default-font-family: "Inter";

    // ─────────────────────────────────────────────
    // Sensor values
    // ─────────────────────────────────────────────

    in property <float> temperature: 23.7;
    in property <float> humidity: 48.0;
    in property <float> pressure: 1013.0;

    in property <string> sensor-status: "X6 CONNECTED";

    // ─────────────────────────────────────────────
    // Colors
    // ─────────────────────────────────────────────

    property <color> background-color: #050a10;
    property <color> text-main: #f4f7fb;
    property <color> text-secondary: #8998aa;

    property <color> temperature-color: #27e6b0;
    property <color> humidity-color: #329cff;
    property <color> pressure-color: #a879ff;

    property <color> gauge-background: #182538;

    background: background-color;

    // ═════════════════════════════════════════════
    // Outer display ring
    // ═════════════════════════════════════════════

    Rectangle {
        x: 3px;
        y: 3px;
        width: 354px;
        height: 354px;

        border-radius: 177px;
        background: transparent;

        border-width: 1px;
        border-color: #263342;
    }

    // ═════════════════════════════════════════════
    // HEADER
    // ═════════════════════════════════════════════

    Text {
        x: 0px;
        y: 42px;
        width: 360px;
        height: 24px;

        text: "ENVIRONMENT";
        color: text-main;

        font-size: 17px;
        font-weight: 700;

        horizontal-alignment: center;
        letter-spacing: 3px;
    }

    // Connection indicator

    Rectangle {
        x: 154px;
        y: 72px;

        width: 52px;
        height: 16px;

        background: transparent;
    }

    Rectangle {
        x: 159px;
        y: 77px;

        width: 10px;
        height: 10px;

        border-radius: 5px;
        background: temperature-color;
    }

    Text {
        x: 174px;
        y: 73px;

        width: 90px;
        height: 18px;

        text: sensor-status;

        color: temperature-color;
        font-size: 9px;
        font-weight: 600;

        vertical-alignment: center;
    }

    // ═════════════════════════════════════════════
    // MAIN TEMPERATURE GAUGE
    // ═════════════════════════════════════════════

    // Background arc
    Path {
        x: 73px;
        y: 96px;
        width: 214px;
        height: 214px;

        commands: "M 107 12 A 95 95 0 1 1 106.99 12.01";

        fill: transparent;
        stroke: gauge-background;
        stroke-width: 12px;
        stroke-line-cap: round;
    }

    // Temperature progress
    //
    // 23.7°C corresponds to roughly 72% on
    // a -10°C → 40°C display range.

    Path {
        x: 73px;
        y: 96px;
        width: 214px;
        height: 214px;

        commands: "M 107 12 A 95 95 0 1 1 22.8 153.8";

        fill: transparent;
        stroke: temperature-color;
        stroke-width: 12px;
        stroke-line-cap: round;
    }

    // ═════════════════════════════════════════════
    // THERMOMETER ICON
    // ═════════════════════════════════════════════

    Path {
        x: 174px;
        y: 112px;
        width: 14px;
        height: 32px;

        commands: "M 7 0 C 3.7 0 1.5 2.5 1.5 5.5 L 1.5 20 C -1 22 0 28 7 28 C 14 28 15 22 12.5 20 L 12.5 5.5 C 12.5 2.5 10.3 0 7 0 Z";

        fill: transparent;
        stroke: temperature-color;
        stroke-width: 2px;
    }

    // ═════════════════════════════════════════════
    // TEMPERATURE VALUE
    // ═════════════════════════════════════════════

    Text {
        x: 0px;
        y: 151px;
        width: 360px;
        height: 75px;

        text: round(temperature) + "." +
            mod(abs(temperature * 10), 10);

        color: text-main;

        font-size: 64px;
        font-weight: 700;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 221px;
        width: 360px;
        height: 32px;

        text: "°C";

        color: text-main;

        font-size: 24px;
        font-weight: 500;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 253px;
        width: 360px;
        height: 20px;

        text: "TEMPERATURE";

        color: text-secondary;

        font-size: 10px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 2px;
    }

    // ═════════════════════════════════════════════
    // HUMIDITY GAUGE
    // ═════════════════════════════════════════════

    // Background

    Path {
        x: 51px;
        y: 267px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 1 1 40.99 5.01";

        fill: transparent;
        stroke: gauge-background;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    // 48% arc

    Path {
        x: 51px;
        y: 267px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 0 1 28.7 74.5";

        fill: transparent;
        stroke: humidity-color;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    // Droplet

    Path {
        x: 83px;
        y: 277px;
        width: 18px;
        height: 23px;

        commands: "M 9 0 C 7 5 1 11 1 15 C 1 20 4.5 23 9 23 C 13.5 23 17 20 17 15 C 17 11 11 5 9 0 Z";

        fill: transparent;
        stroke: humidity-color;
        stroke-width: 2px;
    }

    Text {
        x: 48px;
        y: 300px;
        width: 88px;
        height: 25px;

        text: round(humidity) + "%";

        color: text-main;
        font-size: 20px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    Text {
        x: 48px;
        y: 326px;
        width: 88px;
        height: 14px;

        text: "HUMIDITY";

        color: text-secondary;
        font-size: 8px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }

    // ═════════════════════════════════════════════
    // PRESSURE GAUGE
    // ═════════════════════════════════════════════

    Path {
        x: 227px;
        y: 267px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 1 1 40.99 5.01";

        fill: transparent;
        stroke: gauge-background;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    Path {
        x: 227px;
        y: 267px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 0 1 72 58";

        fill: transparent;
        stroke: pressure-color;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    // Pressure icon

    Path {
        x: 259px;
        y: 277px;
        width: 18px;
        height: 18px;

        commands: "M 9 1 A 8 8 0 1 1 1 9 A 8 8 0 0 1 9 1 M 9 5 L 9 10 L 13 12";

        fill: transparent;
        stroke: pressure-color;
        stroke-width: 2px;
    }

    Text {
        x: 224px;
        y: 300px;
        width: 88px;
        height: 25px;

        text: round(pressure);

        color: text-main;
        font-size: 20px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    Text {
        x: 224px;
        y: 322px;
        width: 88px;
        height: 15px;

        text: "hPa";

        color: text-main;
        font-size: 10px;
        font-weight: 500;

        horizontal-alignment: center;
    }

    Text {
        x: 224px;
        y: 336px;
        width: 88px;
        height: 12px;

        text: "PRESSURE";

        color: text-secondary;
        font-size: 8px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }
}
