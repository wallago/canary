import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

export component EnvironmentDisplay inherits Window {
    width: 360px;
    height: 360px;

    default-font-family: "Inter";

    // ─────────────────────────────────────────────
    // Sensor values
    // ─────────────────────────────────────────────

    in property <float> temperature: 23.7;
    in property <float> humidity: 48.0;
    in property <float> pressure: 1013.0;

    in property <string> sensor-status: "X6 CONNECTED";

    // Slint has no printf. `round()` returns an int, so deriving both halves
    // of the reading from one integer tenths value keeps the fraction from
    // being stringified as a float ("4.30000"). The sensor decodes an
    // unsigned value, so a negative reading cannot reach this.
    property <int> tenths: round(temperature * 10);

    // ─────────────────────────────────────────────
    // Colors
    // ─────────────────────────────────────────────

    property <color> background-color: #050a10;
    property <color> text-main: #f4f7fb;
    property <color> text-secondary: #8998aa;

    property <color> temperature-color: #27e6b0;
    property <color> humidity-color: #329cff;
    property <color> pressure-color: #a879ff;

    property <color> gauge-background: #182538;

    background: background-color;

    // ═════════════════════════════════════════════
    // Outer display ring
    // ═════════════════════════════════════════════

    Rectangle {
        x: 3px;
        y: 3px;
        width: 354px;
        height: 354px;

        border-radius: 177px;
        background: transparent;

        border-width: 1px;
        border-color: #263342;
    }

    // ═════════════════════════════════════════════
    // HEADER
    // ═════════════════════════════════════════════

    Image {
        x: (root.width - self.width) / 2;
        y: 14px;
        width: 38px;
        height: 24px;

        source: @image-url("icons/environment_leaf_24.png");
        colorize: temperature-color;
    }

    Text {
        x: 0px;
        y: 42px;
        width: 360px;
        height: 24px;

        text: "ENVIRONMENT";
        color: text-main;

        font-size: 17px;
        font-weight: 700;

        horizontal-alignment: center;
        letter-spacing: 3px;
    }

    // Connection indicator: dot and label centred as one group.
    //
    // The label is dynamic, so the group cannot be placed with fixed
    // coordinates — the text measures itself and everything else hangs off
    // that. `dot-size` + `dot-gap` is the width the dot contributes.
    property <length> dot-size: 10px;
    property <length> dot-gap: 6px;

    status-label := Text {
        x: (root.width - (self.preferred-width + dot-size + dot-gap)) / 2
            + dot-size + dot-gap;
        y: 72px;
        height: 18px;

        text: sensor-status;

        color: temperature-color;
        font-size: 9px;
        font-weight: 600;

        vertical-alignment: center;
    }

    Rectangle {
        x: status-label.x - dot-size - dot-gap;
        y: status-label.y + (status-label.height - self.height) / 2;

        width: dot-size;
        height: dot-size;

        border-radius: self.width / 2;
        background: temperature-color;
    }

    // ═════════════════════════════════════════════
    // MAIN TEMPERATURE GAUGE
    // ═════════════════════════════════════════════

    // Background arc
    Path {
        x: 73px;
        y: 96px;
        width: 214px;
        height: 214px;

        commands: "M 107 12 A 95 95 0 1 1 106.99 12.01";

        fill: transparent;
        stroke: gauge-background;
        stroke-width: 12px;
        stroke-line-cap: round;
    }

    // Temperature progress
    //
    // 23.7°C corresponds to roughly 72% on
    // a -10°C → 40°C display range.

    Path {
        x: 73px;
        y: 96px;
        width: 214px;
        height: 214px;

        commands: "M 107 12 A 95 95 0 1 1 22.8 153.8";

        fill: transparent;
        stroke: temperature-color;
        stroke-width: 12px;
        stroke-line-cap: round;
    }

    // ═════════════════════════════════════════════
    // THERMOMETER ICON
    // ═════════════════════════════════════════════

    // Icons are images, not paths: the software renderer drops Path elements
    // in line-by-line mode, but draws textures. Each source is white-on-
    // transparent and tinted with `colorize`, so the palette stays defined in
    // one place. They are pre-scaled to their display size — texture sampling
    // here is nearest-neighbour, so runtime downscaling would alias.
    Image {
        x: (root.width - self.width) / 2;
        y: 112px;
        width: 15px;
        height: 32px;

        source: @image-url("icons/thermometer_32.png");
        colorize: temperature-color;
    }

    // ═════════════════════════════════════════════
    // TEMPERATURE VALUE
    // ═════════════════════════════════════════════

    Text {
        x: 0px;
        y: 151px;
        width: 360px;
        height: 75px;

        text: floor(tenths / 10) + "." + mod(tenths, 10);

        color: text-main;

        font-size: 64px;
        font-weight: 700;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 221px;
        width: 360px;
        height: 32px;

        text: "°C";

        color: text-main;

        font-size: 24px;
        font-weight: 500;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 253px;
        width: 360px;
        height: 20px;

        text: "TEMPERATURE";

        color: text-secondary;

        font-size: 10px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 2px;
    }

    // ═════════════════════════════════════════════
    // HUMIDITY GAUGE
    // ═════════════════════════════════════════════

    // Background

    Path {
        x: 71px;
        y: 244px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 1 1 40.99 5.01";

        fill: transparent;
        stroke: gauge-background;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    // 48% arc

    Path {
        x: 71px;
        y: 244px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 0 1 28.7 74.5";

        fill: transparent;
        stroke: humidity-color;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    // Droplet

    Image {
        x: 103px;
        y: 254px;
        width: 17px;
        height: 23px;

        source: @image-url("icons/humidity_drop_23.png");
        colorize: humidity-color;
    }

    Text {
        x: 68px;
        y: 277px;
        width: 88px;
        height: 25px;

        text: round(humidity) + "%";

        color: text-main;
        font-size: 20px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    Text {
        x: 68px;
        y: 303px;
        width: 88px;
        height: 14px;

        text: "HUMIDITY";

        color: text-secondary;
        font-size: 8px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }

    // ═════════════════════════════════════════════
    // PRESSURE GAUGE
    // ═════════════════════════════════════════════

    Path {
        x: 207px;
        y: 244px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 1 1 40.99 5.01";

        fill: transparent;
        stroke: gauge-background;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    Path {
        x: 207px;
        y: 244px;
        width: 82px;
        height: 82px;

        commands: "M 41 5 A 36 36 0 0 1 72 58";

        fill: transparent;
        stroke: pressure-color;
        stroke-width: 5px;
        stroke-line-cap: round;
    }

    // Pressure icon

    Image {
        x: 239px;
        y: 254px;
        width: 18px;
        height: 18px;

        source: @image-url("icons/pressure_gauge_18.png");
        colorize: pressure-color;
    }

    Text {
        x: 204px;
        y: 277px;
        width: 88px;
        height: 25px;

        text: round(pressure);

        color: text-main;
        font-size: 20px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    Text {
        x: 204px;
        y: 299px;
        width: 88px;
        height: 15px;

        text: "hPa";

        color: text-main;
        font-size: 10px;
        font-weight: 500;

        horizontal-alignment: center;
    }

    Text {
        x: 204px;
        y: 313px;
        width: 88px;
        height: 12px;

        text: "PRESSURE";

        color: text-secondary;
        font-size: 8px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }
}
