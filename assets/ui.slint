import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

// A gauge arc, not a full circle: fixed span of 260°, gap centered at 6
// o'clock, matching the reference design. Two layers:
//
// 1. A pre-baked image (see bake_rings2.py) — the arc already cropped to
//    [start-deg, start-deg + span-deg], gradient-colored as if fully read.
//    Gradient brushes can only be painted as an unclipped rectangle on this
//    renderer (`border-radius` is only implemented for solid-color
//    backgrounds — confirmed against the renderer source: the
//    ConicGradient scene item carries no radius, unlike RoundedRectangle),
//    so there is no way to draw this arc live; it has to be a texture.
// 2. A flat gray stroke arc painted over the unread remainder, from the
//    current reading to the end of the span — flat colors render fine as a
//    live Path stroke, so this part stays dynamic.
//
// No separate hole/disc layer: the window's own background shows through
// the center and the gap, so it is always exactly right by construction.
component ProgressRing {
    in property <length> diameter;
    in property <length> thickness;
    in property <float> fill;
    in property <image> gradient-image;
    in property <color> track-color;

    private property <float> start-deg: 230;
    private property <float> span-deg: 260;
    private property <float> fill-end-deg: start-deg + fill * span-deg;

    private property <float> px-diameter: diameter / 1px;
    private property <float> center: px-diameter / 2;
    // The stroke draws inward from its path line rather than straddling
    // it, so the path itself has to run along the ring's outer edge, not
    // its centerline.
    private property <float> band-radius: center + 1;

    width: diameter;
    height: diameter;

    Image {
        width: 100%;
        height: 100%;
        source: gradient-image;
        image-fit: ImageFit.fill;
    }

    Path {
        width: 100%;
        height: 100%;

        viewbox-width: px-diameter;
        viewbox-height: px-diameter;

        fill: transparent;
        stroke: track-color;
        stroke-width: thickness + 2px;
        stroke-line-cap: butt;

        MoveTo {
            x: center + band-radius * sin(fill-end-deg * 1deg);
            y: center - band-radius * cos(fill-end-deg * 1deg);
        }

        ArcTo {
            radius-x: band-radius;
            radius-y: band-radius;
            x: center + band-radius * sin((start-deg + span-deg) * 1deg);
            y: center - band-radius * cos((start-deg + span-deg) * 1deg);
            sweep: true;
            large-arc: (span-deg * (1 - fill)) > 180;
        }
    }
}

export component EnvironmentDisplay inherits Window {
    width: 360px;
    height: 360px;

    default-font-family: "Inter";

    // ─────────────────────────────────────────────
    // Sensor values
    // ─────────────────────────────────────────────

    in property <float> temperature: 23.7;
    in property <float> humidity: 48.0;
    in property <float> pressure: 1013.0;

    in property <string> sensor-status: "X6 CONNECTED";

    // Slint has no printf. `round()` returns an int, so deriving both halves
    // of the reading from one integer tenths value keeps the fraction from
    // being stringified as a float ("4.30000"). The sensor decodes an
    // unsigned value, so a negative reading cannot reach this.
    property <int> tenths: round(temperature * 10);

    // Sensor value mapped onto its dial, 0..1. `min(0.9999, ...)` is Slint's
    // own workaround (see SpinnerBase): a sweep of exactly 1.0 collapses to
    // nothing instead of closing the circle.
    property <float> temperature-fill: min(0.9999, max(0.0, (temperature - 5) / 40));
    property <float> humidity-fill: min(0.9999, max(0.0, humidity / 100));
    property <float> pressure-fill: min(0.9999, max(0.0, (pressure - 950) / 150));

    // ─────────────────────────────────────────────
    // Colors
    // ─────────────────────────────────────────────

    property <color> background-color: #0b0d10;
    property <color> text-main: #ffffff;
    property <color> text-secondary: #8c949e;

    // Unread remainder of a gauge arc.
    property <color> track-color: #363b42;

    // Leaf icon, status dot, status label.
    property <color> accent-color: #34d399;

    // Icon tints. Each is its ring's own choice, not derived from the ring's
    // gradient stops.
    property <color> thermometer-tint: #34d67a;
    property <color> humidity-tint: #2e7dd1;
    property <color> pressure-tint: #7b5ce0;

    background: background-color;

    // ═════════════════════════════════════════════
    // Outer display ring
    // ═════════════════════════════════════════════

    Rectangle {
        x: 0px;
        y: 0px;
        width: 360px;
        height: 360px;

        border-radius: 180px;
        background: transparent;

        border-width: 3px;
        border-color: #2d3035;
    }

    // ═════════════════════════════════════════════
    // HEADER
    // ═════════════════════════════════════════════

    Image {
        x: (root.width - self.width) / 2;
        y: 15px;
        width: 42px;
        height: 26px;

        source: @image-url("icons/environment_leaf_42.png");
        colorize: accent-color;
    }

    Text {
        x: 0px;
        y: 44px;
        width: 360px;
        height: 34px;

        text: "ENVIRONMENT";
        color: text-main;

        font-size: 28px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    // Connection indicator: dot and label centred as one group.
    //
    // The label is dynamic, so the group cannot be placed with fixed
    // coordinates — the text measures itself and everything else hangs off
    // that. `dot-size` + `dot-gap` is the width the dot contributes.
    property <length> dot-size: 5px;
    property <length> dot-gap: 3px;

    status-label := Text {
        x: (root.width - (self.preferred-width + dot-size + dot-gap)) / 2
            + dot-size + dot-gap;
        y: 78px;
        height: 16px;

        text: sensor-status;

        color: accent-color;
        font-size: 13px;
        font-weight: 700;

        vertical-alignment: center;
    }

    Rectangle {
        x: status-label.x - dot-size - dot-gap;
        y: status-label.y + (status-label.height - self.height) / 2;

        width: dot-size;
        height: dot-size;

        border-radius: self.width / 2;
        background: accent-color;
    }

    // ═════════════════════════════════════════════
    // MAIN TEMPERATURE GAUGE
    // ═════════════════════════════════════════════

    // Temperature progress, -10°C..40°C, sweeping clockwise from 12 o'clock.
    ProgressRing {
        x: 105px;
        y: 99px;

        diameter: 150px;
        thickness: 12px;

        fill: temperature-fill;
        track-color: track-color;
        gradient-image: @image-url("icons/gauge_temperature_150.png");
    }

    // ═════════════════════════════════════════════
    // THERMOMETER ICON
    // ═════════════════════════════════════════════

    // Icons are images, not paths: the software renderer drops Path elements
    // in line-by-line mode, but draws textures. Each source is white-on-
    // transparent and tinted with `colorize`, so the palette stays defined in
    // one place. They are pre-scaled to their display size — texture sampling
    // here is nearest-neighbour, so runtime downscaling would alias.
    Image {
        x: 173px;
        y: 120px;
        width: 16px;
        height: 35px;

        source: @image-url("icons/thermometer_35.png");
        colorize: thermometer-tint;
    }

    // ═════════════════════════════════════════════
    // TEMPERATURE VALUE
    // ═════════════════════════════════════════════

    Text {
        x: 0px;
        y: 151px;
        width: 360px;
        height: 58px;

        text: floor(tenths / 10) + "." + mod(tenths, 10);

        color: text-main;

        font-size: 48px;
        font-weight: 700;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 202px;
        width: 360px;
        height: 19px;

        text: "°C";

        color: text-main;

        font-size: 16px;
        font-weight: 700;

        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 219px;
        width: 360px;
        height: 15px;

        text: "TEMPERATURE";

        color: text-secondary;

        font-size: 12px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }

    // ═════════════════════════════════════════════
    // HUMIDITY GAUGE
    // ═════════════════════════════════════════════

    ProgressRing {
        x: 79px;
        y: 249px;

        diameter: 88px;
        thickness: 5px;

        fill: humidity-fill;
        track-color: track-color;
        gradient-image: @image-url("icons/gauge_humidity_88.png");
    }

    // Droplet

    Image {
        x: 114px;
        y: 262px;
        width: 18px;
        height: 24px;

        source: @image-url("icons/humidity_drop_24.png");
        colorize: humidity-tint;
    }

    Text {
        x: 79px;
        y: 289px;
        width: 88px;
        height: 21px;

        text: round(humidity) + "%";

        color: text-main;
        font-size: 17px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    Text {
        x: 79px;
        y: 319px;
        width: 88px;
        height: 11px;

        text: "HUMIDITY";

        color: text-secondary;
        font-size: 9px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }

    // ═════════════════════════════════════════════
    // PRESSURE GAUGE
    // ═════════════════════════════════════════════

    ProgressRing {
        x: 191px;
        y: 249px;

        diameter: 88px;
        thickness: 5px;

        fill: pressure-fill;
        track-color: track-color;
        gradient-image: @image-url("icons/gauge_pressure_88.png");
    }

    // Pressure icon

    Image {
        x: 223px;
        y: 259px;
        width: 24px;
        height: 24px;

        source: @image-url("icons/pressure_gauge_24.png");
        colorize: pressure-tint;
    }

    Text {
        x: 191px;
        y: 284px;
        width: 88px;
        height: 21px;

        text: round(pressure);

        color: text-main;
        font-size: 17px;
        font-weight: 700;

        horizontal-alignment: center;
    }

    // Not in the Figma spec pasted — inferred position in the gap between
    // the value and the PRESSURE caption.
    Text {
        x: 191px;
        y: 305px;
        width: 88px;
        height: 12px;

        text: "hPa";

        color: text-secondary;
        font-size: 9px;
        font-weight: 500;

        horizontal-alignment: center;
    }

    Text {
        x: 191px;
        y: 319px;
        width: 88px;
        height: 11px;

        text: "PRESSURE";

        color: text-secondary;
        font-size: 9px;
        font-weight: 600;

        horizontal-alignment: center;
        letter-spacing: 1px;
    }
}
