import { Theme } from "theme.slint";

export component Temperature {
    in property <float> temperature;

    property <int> tenths: round(temperature * 10);

    property <length> icon-size: 38px;
    property <length> icon-gap: 0px;

    Image {
        x: 0px;
        y: (value.y + (value.height - self.height) / 2) + 4px;
        width: icon-size;
        height: icon-size;

        source: @image-url("../icons/Temp.png");
        colorize: Theme.thermometer-tint;
        vertical-alignment: center;
    }

    value := Text {
        x: icon-size + icon-gap;
        y: 0px;
        width: 120px;

        text: floor(tenths / 10) + "." + mod(tenths, 10);

        color: Theme.text-main;
        font-size: 48px;
        font-weight: 700;
    }

    Text {
        x: 150px;
        y: 8px;

        text: "°C";

        color: Theme.text-main;
        font-size: 16px;
        font-weight: 700;
    }
}
