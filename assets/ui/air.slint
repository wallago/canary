import { Theme } from "theme.slint";
import { PageHeader } from "comfort.slint";

// Page 2: the sensor's air quality index as one big word, over a four-step
// scale with the current step lit.
export component AirPage {
    // "good", "moderate", "unhealthy" or "hazardous", as the sensor reports.
    in property <string> iaq;

    property <int> level: iaq == "good" ? 1 : iaq == "moderate" ? 2 : iaq == "unhealthy" ? 3 : 4;
    property <color> tone: level == 1 ? Theme.good : level == 2 ? Theme.warning : Theme.bad;

    width: 360px;
    height: 360px;

    PageHeader {
        y: 52px;
        title: "AIR QUALITY";
        active: 1;
    }

    Text {
        y: 118px;
        width: parent.width;
        text: level == 1 ? "GOOD" : level == 2 ? "FAIR" : level == 3 ? "POOR" : "BAD";
        color: tone;
        font-size: 76px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Good, fair, poor, bad from left to right. Each step keeps its own
    // colour; only the current one is lit and taller.
    HorizontalLayout {
        y: 226px;
        width: parent.width;
        height: 14px;
        alignment: center;
        spacing: 8px;

        for step in [
            { level: 1, color: Theme.good },
            { level: 2, color: Theme.warning },
            { level: 3, color: Theme.bad },
            { level: 4, color: Theme.bad },
        ]: Rectangle {
            width: 52px;
            height: 14px;

            Rectangle {
                y: step.level == root.level ? 0px : 3px;
                height: step.level == root.level ? 14px : 8px;
                border-radius: self.height / 2;
                background: step.level == root.level ? step.color : step.color.with-alpha(0.25);
            }
        }
    }

    Text {
        y: 258px;
        width: parent.width;
        text: level == 1 ? "Nothing to do" : "Let some air in";
        color: Theme.text-secondary;
        font-size: 20px;
        font-weight: 500;
        horizontal-alignment: center;
    }
}
