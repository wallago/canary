import { Theme } from "theme.slint";

// A 270° arc gauge, open at the bottom. `fraction` 0..1 fills it clockwise
// from the lower left.
export component Gauge {
    in property <float> fraction;
    in property <brush> color;
    in property <brush> track: Theme.track;
    in property <length> thickness: 10px;

    property <float> size: root.width / 1px;
    property <float> r: (size - root.thickness / 1px) / 2;
    property <float> c: size / 2;
    property <angle> start: 135deg;
    property <angle> sweep: 270deg * clamp(root.fraction, 0, 1);

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: size;
        viewbox-height: size;

        stroke: root.track;
        stroke-width: root.thickness;
        stroke-line-cap: round;

        MoveTo {
            x: c + r * cos(start);
            y: c + r * sin(start);
        }

        ArcTo {
            x: c + r * cos(start + 270deg);
            y: c + r * sin(start + 270deg);
            radius-x: r;
            radius-y: r;
            large-arc: true;
            sweep: true;
        }
    }

    // A zero-length arc still paints its round caps, so skip it when empty.
    if root.fraction > 0.01: Path {
        width: 100%;
        height: 100%;
        viewbox-width: size;
        viewbox-height: size;

        stroke: root.color;
        stroke-width: root.thickness;
        stroke-line-cap: round;

        MoveTo {
            x: c + r * cos(start);
            y: c + r * sin(start);
        }

        ArcTo {
            x: c + r * cos(start + sweep);
            y: c + r * sin(start + sweep);
            radius-x: r;
            radius-y: r;
            large-arc: sweep > 180deg;
            sweep: true;
        }
    }
}

// Three dots under a page title; `active` is the lit one.
export component PageDots {
    in property <int> active;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        for i in 3: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: i == root.active ? Theme.accent-color : Theme.ring;
        }
    }
}

// Page 1: temperature and humidity gauges, and one verdict.
export component ComfortPage {
    in property <float> temperature;
    in property <float> humidity;
    in property <string> verdict;
    in property <bool> ok;

    property <int> tenths: round(temperature * 10);
    property <color> tone: ok ? Theme.good : Theme.warning;

    width: 360px;
    height: 360px;

    Text {
        y: 34px;
        width: parent.width;
        text: "COMFORT";
        color: Theme.text-main;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 3px;
        horizontal-alignment: center;
    }

    PageDots {
        y: 62px;
        width: parent.width;
        active: 0;
    }

    // Temperature, 10–30 °C across the arc.
    Gauge {
        x: 33px;
        y: 88px;
        width: 140px;
        height: 140px;
        fraction: (temperature - 10) / 20;
        color: Theme.thermometer-tint;
    }

    Text {
        x: 33px;
        y: 124px;
        width: 140px;
        text: floor(tenths / 10) + "." + mod(tenths, 10);
        color: Theme.text-main;
        font-size: 46px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: 33px;
        y: 180px;
        width: 140px;
        text: "°C";
        color: Theme.thermometer-tint;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    // Humidity, 0–100 % across the arc.
    Gauge {
        x: 187px;
        y: 88px;
        width: 140px;
        height: 140px;
        fraction: humidity / 100;
        color: Theme.humidity-tint;
    }

    Text {
        x: 187px;
        y: 124px;
        width: 140px;
        text: round(humidity);
        color: Theme.text-main;
        font-size: 46px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: 187px;
        y: 180px;
        width: 140px;
        text: "%";
        color: Theme.humidity-tint;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: 33px;
        y: 228px;
        width: 140px;
        text: "TEMP";
        color: Theme.text-secondary;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 2px;
        horizontal-alignment: center;
    }

    Text {
        x: 187px;
        y: 228px;
        width: 140px;
        text: "HUMIDITY";
        color: Theme.text-secondary;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 2px;
        horizontal-alignment: center;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 262px;
        width: pill.preferred-width + 56px;
        height: 48px;
        border-radius: 24px;
        border-width: 2px;
        border-color: tone;
        background: tone.with-alpha(0.12);

        pill := Text {
            text: verdict;
            color: tone;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 1px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
